config router 'main'
	option host '192.168.8.1'
	# Optional HTTP Host header override for proxies/port-forwards.
	# Examples: option host 'https://10.0.0.2:8086' or 'http://10.0.0.2:8087' with option http_host 'homerouter.cpe'
	option http_host ''
	# Optional TLS SNI override; defaults to the URL host.
	option tls_sni ''
	# Interface name or local source IP for outbound router requests.
	# Use this when several attached routers share the same management IP.
	# If an interface has multiple IPv4 addresses, the collector prefers one in the router host subnet, then RFC1918 management addresses.
	option interface ''
	# Leave username empty on password-only WebUIs; the API still uses admin internally.
	option username 'admin'
	option password ''
	option timeout '9'
	# Collectors to scrape: 'all', 'none', or a space/comma separated list.
	# Bridge-mode suggested list, excluding Wi-Fi/voice/firewall/UPnP-only data:
	#   device_signal monitoring_status traffic_statistics device_information current_plmn lan_hosts monitoring_converged_status monitoring_notifications monitoring_start_date monitoring_month_statistics monitoring_statistic_feature_switch monitoring_onekey_diag device_basic_information device_feature_switch device_boot_time net_net_mode net_network net_register net_net_mode_list net_feature_switch net_cell_info net_csps_state dialup_mobile_dataswitch dialup_connection dialup_feature_switch dialup_profiles sms_count sms_splitinfo sms_feature_switch sms_send_status pin_status pin_simlock security_bridgemode global_module_switch
	# All collectors:
	#   device_signal monitoring_status traffic_statistics device_information current_plmn wlan_hosts lan_hosts monitoring_converged_status monitoring_notifications monitoring_start_date monitoring_month_statistics monitoring_statistic_feature_switch monitoring_onekey_diag device_basic_information device_feature_switch device_boot_time net_net_mode net_network net_register net_net_mode_list net_feature_switch net_cell_info net_csps_state dialup_mobile_dataswitch dialup_connection dialup_feature_switch dialup_profiles dhcp_settings dhcp_feature_switch sms_count sms_splitinfo sms_feature_switch sms_send_status pin_status pin_simlock wlan_wifi_feature_switch wlan_multi_basic_settings wlan_multi_switch_settings wlan_status_switch_settings wlan_guesttime_setting wlan_wps_switch security_bridgemode security_upnp voice_voiperstatus voice_volte global_module_switch ntwk_upnp_portmapping
	option collectors 'all'
