config connectbox 'main'
	option host '192.168.0.1'
	# Interface name or local source IP for outbound router requests.
	# Use this when several attached routers share the same management IP.
	option interface ''
	option password ''
	# Use 'cbn' for current Connect Box firmware login encryption, or 'plain'
	# for older firmware that accepts the password directly.
	option password_encryption 'cbn'
	option timeout '9'
