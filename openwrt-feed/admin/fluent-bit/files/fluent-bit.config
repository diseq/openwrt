config fluent-bit 'main'
	# Set to 0 to make /etc/init.d/fluent-bit start a no-op even when the service is enabled.
	option enabled '1'
	# Native Fluent Bit configuration file, not UCI syntax.
	option config '/etc/fluent-bit/fluent-bit.conf'
	# Optional extra command-line arguments appended after -c <config>.
	option extra_args ''
	option stdout '1'
	option stderr '1'
	option respawn '1'
