#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

PROG=/usr/sbin/fluent-bit
DEFAULT_CONFIG=/etc/fluent-bit/fluent-bit.conf

start_service() {
	local enabled config extra_args stdout stderr respawn

	config_load fluent-bit
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get config main config "$DEFAULT_CONFIG"
	config_get extra_args main extra_args ""
	config_get_bool stdout main stdout 1
	config_get_bool stderr main stderr 1
	config_get_bool respawn main respawn 1

	[ -x "$PROG" ] || return 1
	if [ ! -r "$config" ]; then
		echo "fluent-bit: missing config: $config" >&2
		return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG" -c "$config"
	[ -z "$extra_args" ] || procd_append_param command $extra_args
	[ "$stdout" -eq 1 ] && procd_set_param stdout 1
	[ "$stderr" -eq 1 ] && procd_set_param stderr 1
	[ "$respawn" -eq 1 ] && procd_set_param respawn
	procd_close_instance
}

reload_service() {
	procd_send_signal fluent-bit
}
